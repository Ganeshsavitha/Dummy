{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "outDir": "../dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node10",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "config/**/*",
    "controllers/**/*",
    "middlewares/**/*",
    "routes/**/*",
    "services/**/*",
    "utils/**/*",
    "validators/**/*"
  ]
}